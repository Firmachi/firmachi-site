# Адреса сайта, который стоял на этом домене до нынешнего (Tilda). Google до сих
# пор держит их в индексе и отправляет на них людей: по данным Search Console за
# 8 сентября — 15 ноября 2026 на /about и /works пришло 3 клика из 25 — 12 % всего
# трафика из поиска, — и оба отдавали 404. Позиция у обоих 2,3, то есть Google
# показывает их выше, чем большинство живых страниц.
#
# Цели выбраны по тому, чем страница была на самом деле: заголовки подняты из
# веб-архива, а не угаданы по слагу.
#
#   /about     «О КОМПАНИИ»            -> отдельной страницы о студии сейчас нет,
#                                         описание компании живёт на главной.
#                                         Когда появится страница команды, цель
#                                         надо сменить на неё.
#   /works     портфолио               -> /portfolio
#   /contacts  контакты                -> /kontakty
#   /produced  «Услуги продюсирования» -> /uslugi/prodyusirovanie
#
# Трейлинг-слеш отдельным правилом не нужен: Netlify сам приводит /about/ к /about.

/about      /                         301
/works      /portfolio                301
/contacts   /kontakty                 301
/produced   /uslugi/prodyusirovanie   301

